PORT=5000
# Hosting/container: use 0.0.0.0; keep loopback for local development.
HOST=127.0.0.1
# Set to the exact number of trusted reverse-proxy hops (e.g. 1 on Render).
TRUST_PROXY_HOPS=0
MONGO_URI=mongodb://127.0.0.1:27017/streamx
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
CLIENT_URL=http://127.0.0.1:5173
MAX_UPLOAD_MB=500
# Absolute path to persistent storage in production.
# STORAGE_DIR=/var/data/streamx
# Optional: override bundled binaries
# FFMPEG_PATH=/usr/local/bin/ffmpeg
# FFPROBE_PATH=/usr/local/bin/ffprobe
# Free-hosting mode: persist originals, playlists, thumbnails and segments in MongoDB.
MEDIA_STORAGE=disk
MEDIA_QUOTA_MB=350
# 0 = no duration cap. render.yaml sets 120 seconds for the free demo.
MAX_VIDEO_SECONDS=0
FFMPEG_THREADS=2
